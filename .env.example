# Environment Variables for PLACEMEIN CRM

# ==========================================
# Frontend (Vercel) Environment Variables:
# ==========================================
# Point to your Render backend web service URL (e.g., https://your-backend.onrender.com)
VITE_API_URL=

# Optional: Base path (defaults to '/' on Vercel)
VITE_BASE_PATH=/

# ==========================================
# Backend (Render) Environment Variables:
# ==========================================
PORT=3000
NODE_ENV=production
SECRET_KEY=supersecretkeyforcraoutreachpipelinechangeinprod

# Optional: Restrict CORS to your Vercel frontend URL
FRONTEND_URL=

# AI & Enrichment Services (Optional / Free Tier)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Supabase (Optional: For serverless shared database on Netlify/Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

